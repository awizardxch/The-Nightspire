# Environment Variables Example
# Copy this to .env.local and fill in your values. In Vercel, set the same
# names under Project → Settings → Environment Variables (VITE_* values are
# baked in at build time, so redeploy after changing them).

# Discord Application ID from the Developer Portal (Activity SDK + /api/token)
VITE_DISCORD_CLIENT_ID=your_application_id_here
# Server-side only: OAuth2 secret for the /api/token code exchange
DISCORD_CLIENT_SECRET=

# WalletConnect/Reown Project ID for the wallet menu in the top bar
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Game hub (see docs/GAME_HUB.md)
# Built-in hubs: name|origin|discord-path, comma separated; first is the default
VITE_GAME_HUBS=BOW Hub|https://hub.awizard.dev|/hub/bow
# chia-gaming client, served by this same project from public/games/
VITE_GAME_CLIENT_URL=https://play.awizard.dev/games
VITE_GAME_CLIENT_DISCORD_PATH=/games

# Optional, local development only
# VITE_TOKEN_EXCHANGE_URL=http://localhost:5173/.proxy/api/token
