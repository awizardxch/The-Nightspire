# Environment Variables Example
# Copy this to .env.local and fill in your values

# Required - Discord Application ID from Developer Portal
VITE_DISCORD_CLIENT_ID=your_application_id_here

# Required - WalletConnect/Reown Project ID for wallet connections  
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Optional - External service URLs (leave empty for local development)
VITE_AWIZARD_BOT_URL=
VITE_GYM_SERVER_URL=http://localhost:3001  
VITE_BOW_APP_URL=http://localhost:3000

# Game hub (see docs/GAME_HUB.md)
# Built-in hubs: name|origin|discord-path, comma separated; first is the default
VITE_GAME_HUBS=BOW Hub|https://hub.awizard.dev|/hub/bow
# chia-gaming client build: web URL, and the Discord URL-mapping prefix serving it
VITE_GAME_CLIENT_URL=
VITE_GAME_CLIENT_DISCORD_PATH=/play

# Feature flags
VITE_REQUIRE_NFT_GATE=false

# Upstash Redis — public lobby registry (shared across bow-app + nightspire)
# Create free DB at https://console.upstash.com → copy REST URL + token
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Token exchange endpoint (for development - auto-configured)
# VITE_TOKEN_EXCHANGE_URL=http://localhost:5173/.proxy/api/token