+import { webcrypto } from 'node:crypto';
+import { toWsUrl } from '../../../../hub/hub-frontend/src/useHubSocket';
+import { deriveHubSessionId } from '../../services/hubSessionCredential';
+import { canonicalHubUrl, hubResourceUrl } from '../../services/hubUrl';
+
+const subtle = webcrypto.subtle as unknown as SubtleCrypto;
+const MASTER = '01'.repeat(16);
+
+describe('hub URLs with a path prefix', () => {
+  it('canonicalizes a root hub to its bare origin', () => {
+    expect(canonicalHubUrl('https://hub.example')).toBe('https://hub.example');
+    expect(canonicalHubUrl('https://hub.example/')).toBe('https://hub.example');
+    expect(canonicalHubUrl('https://HUB.example:443//')).toBe('https://hub.example');
+  });
+
+  it('keeps a path prefix without its trailing slash', () => {
+    expect(canonicalHubUrl('https://host.example/hub/bow/')).toBe('https://host.example/hub/bow');
+    expect(canonicalHubUrl('https://host.example/hub/bow?q=1#f')).toBe(
+      'https://host.example/hub/bow',
+    );
+  });
+
+  it('rejects non-http schemes', () => {
+    expect(() => canonicalHubUrl('ftp://hub.example')).toThrow('unsupported hub URL protocol');
+  });
+
+  it('resolves the lobby page and relay under the hub', () => {
+    expect(hubResourceUrl('https://hub.example', './').href).toBe('https://hub.example/');
+    expect(hubResourceUrl('https://hub.example', 'ws/game').href).toBe(
+      'https://hub.example/ws/game',
+    );
+    expect(hubResourceUrl('https://host.example/hub/bow', './').href).toBe(
+      'https://host.example/hub/bow/',
+    );
+    expect(hubResourceUrl('https://host.example/hub/bow/', 'ws/game').href).toBe(
+      'https://host.example/hub/bow/ws/game',
+    );
+  });
+
+  it('builds the lobby page matchmaking socket relative to the page', () => {
+    expect(toWsUrl('https://hub.example/')).toBe('wss://hub.example/ws/hub');
+    expect(toWsUrl('http://localhost:3003/')).toBe('ws://localhost:3003/ws/hub');
+    expect(toWsUrl('https://host.example/hub/bow/')).toBe('wss://host.example/hub/bow/ws/hub');
+  });
+
+  it('keeps the session credential of root hubs unchanged', async () => {
+    // Values derived by the code before hub paths were supported.
+    await expect(deriveHubSessionId(MASTER, 'https://hub.example', subtle)).resolves.toBe(
+      '7477870d8c06de4022e60f615229c871',
+    );
+    await expect(deriveHubSessionId(MASTER, 'https://hub.example/', subtle)).resolves.toBe(
+      '7477870d8c06de4022e60f615229c871',
+    );
+    await expect(deriveHubSessionId(MASTER, 'http://localhost:3003', subtle)).resolves.toBe(
+      '6600f688ea9eb09518916ae26e1ca959',
+    );
+  });
+
+  it('gives two hubs on one origin different session credentials', async () => {
+    const a = await deriveHubSessionId(MASTER, 'https://host.example/hub/a', subtle);
+    const b = await deriveHubSessionId(MASTER, 'https://host.example/hub/b', subtle);
+    const root = await deriveHubSessionId(MASTER, 'https://host.example', subtle);
+    expect(new Set([a, b, root]).size).toBe(3);
+    await expect(deriveHubSessionId(MASTER, 'https://host.example/hub/a/', subtle)).resolves.toBe(
+      a,
+    );
+  });
+});
