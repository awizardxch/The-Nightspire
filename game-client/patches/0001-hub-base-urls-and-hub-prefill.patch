diff --git a/front-end/src/services/hubUrl.ts b/front-end/src/services/hubUrl.ts
new file mode 100644
index 0000000..47e1680
--- /dev/null
+++ b/front-end/src/services/hubUrl.ts
@@ -0,0 +1,26 @@
+// A hub's address: an http(s) origin, optionally followed by a path prefix.
+//
+// Most hubs live at the root of their origin. A hub can also sit under a path,
+// for example behind a reverse proxy or an embedding host that maps one path
+// per server (https://host.example/hub/a). Everything a hub serves (its lobby
+// page, /ws/hub and /ws/game) is resolved relative to the hub URL.
+//
+// Canonical form: a root hub is its bare origin ("https://hub.example"), so the
+// value is unchanged from when hubs were origins only and the session
+// credentials derived from it stay the same. A hub under a path is the origin
+// plus the path without its trailing slash ("https://host.example/hub/a").
+// Query strings and fragments are never part of a hub URL.
+
+export function canonicalHubUrl(hubUrl: string): string {
+  const url = new URL(hubUrl);
+  if (url.protocol !== 'http:' && url.protocol !== 'https:') {
+    throw new Error(`unsupported hub URL protocol: ${url.protocol}`);
+  }
+  const path = url.pathname.replace(/\/+$/, '');
+  return path ? `${url.origin}${path}` : url.origin;
+}
+
+/** Absolute URL of `relative` (e.g. "ws/game", "./") under the hub. */
+export function hubResourceUrl(hubUrl: string, relative: string): URL {
+  return new URL(relative, `${canonicalHubUrl(hubUrl)}/`);
+}
